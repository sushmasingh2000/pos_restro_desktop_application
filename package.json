{
  "name": "restro-panel",
  "version": "1.0.40",
  "description": "POS software for restaurant management and billing system",
  "author": "Sushma Singh",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "animate.css": "^4.1.1",
    "aos": "^2.3.4",
    "axios": "^1.16.1",
    "bootstrap": "^5.3.8",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.3",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "moment": "^2.30.1",
    "node-thermal-printer": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-query": "^3.39.3",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "redux-persist": "^6.0.0",
    "sweetalert2": "^11.22.2",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "homepage": "./",
  "main": "main.js",
  "scripts": {
    "start": "react-scripts start",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"npm run electron\"",
    "build": "set \"GENERATE_SOURCEMAP=false\" &&  react-scripts build",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.restropanel",
    "productName": "RestroPanel",
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "../backend/dist/server.js",
        "to": "resources/backend/server.js"
      },
      {
        "from": "../backend/node_modules",
        "to": "resources/backend/node_modules"
      },
      {
        "from": "../backend/.env",
        "to": "resources/backend/.env"
      },
      {
        "from": "../backend/node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "resources/backend/sql-wasm.wasm"
      },
      {
        "from": "resources/node.exe",
        "to": "resources/node.exe"
      },
      {
        "from": "resources/node_win7.exe",
        "to": "resources/node_win7.exe"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis",
      "artifactName": "RestroPanel Setup ${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "sushmasingh2000",
      "repo": "pos_restro_desktop_application"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.15",
    "wait-on": "^9.0.10"
  }
}
